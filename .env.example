# ============================================================
# FONSETECH - Central de Chamados
# TEMPLATE. Apenas nomes de variaveis, sem valores reais.
#
# Local:      copie para .env e preencha (o .env esta no .gitignore)
# Producao:   cadastre em Railway > Project > Variables
#             NUNCA versione valores reais neste arquivo
# ============================================================

# --- Supabase -----------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
NODE_ENV=production

# --- Espelho para o frontend (Vite) -------------------------
# Restricao do build: o Vite so injeta no navegador variaveis
# prefixadas com VITE_. Portanto o frontend le estas duas, que
# devem receber os MESMOS valores de SUPABASE_URL e
# SUPABASE_ANON_KEY acima.
#
# Estas duas sao publicas por natureza: quem autoriza o acesso
# aos dados e o RLS no Supabase, nao o segredo da chave.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NUNCA crie VITE_SUPABASE_SERVICE_ROLE_KEY.
# O prefixo VITE_ embute o valor no JavaScript entregue ao
# navegador - isso vazaria acesso total ao banco, ignorando RLS.
