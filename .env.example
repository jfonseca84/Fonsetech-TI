# ============================================================
# FONSETECH - Central de Chamados
# TEMPLATE. Apenas nomes de variaveis, sem valores reais.
#
# Local:     copie para .env e preencha (o .env esta no .gitignore)
# Producao:  cadastre em Railway > Project > Variables
#            NUNCA versione valores reais neste arquivo
#
# O frontend depende SOMENTE destas duas variaveis. Elas sao publicas
# por natureza: quem autoriza o acesso aos dados e o RLS no Supabase,
# nao o segredo da chave. Estao em Supabase > Settings > API
# (Project URL e chave "anon public").
# ============================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional, apenas para o servidor estatico (a Railway injeta sozinha):
# PORT=8080
# NODE_ENV=production

# NAO adicione SUPABASE_SERVICE_ROLE_KEY nem DATABASE_URL aqui.
# Nenhum arquivo deste projeto usa essas variaveis, e o prefixo VITE_
# embutiria o valor no JavaScript entregue ao navegador - o que vazaria
# acesso total ao banco, ignorando o RLS.
